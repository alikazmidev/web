
---
import Base from '../layouts/Base.astro';
---

<Base
  title="Projects by Ali Kazmi | Ali Abbas Kazmi"
  pageType="projects"
  description="Explore projects by Ali Abbas Kazmi (Ali Kazmi), including Zenith, a productivity browser extension, and his personal portfolio."
>
  <div class="wrap inner-page">
    <p class="eyebrow">~/projects</p>

    <h1>
      Things I'm<br />
      building<span class="period">.</span>
    </h1>

    <p class="page-intro">
      Building things, breaking things and learning along the way.
    </p>

    <!-- PROJECT 001 -->
    <div class="project-detail">
      <div class="section-heading">
        <span class="section-label">
          001 / PERSONAL PROJECT
        </span>

        <span class="status">
          <span class="status-dot"></span>
          This website
        </span>
      </div>

      <h2>aliabbaskazmi.com</h2>

      <p>
        A minimalist personal portfolio built with Astro,
        TypeScript and CSS. A place to document what I
        learn and build.
      </p>

      <div class="tags">
        <span>Astro</span>
        <span>TypeScript</span>
        <span>Cloudflare Pages</span>
      </div>
    </div>

    <!-- PROJECT 002 -->
    <div class="project-detail">
      <div class="section-heading">
        <span class="section-label">
          002 / BROWSER EXTENSION
        </span>

        <span class="status">
          <span class="status-dot"></span>
          Beta Release
        </span>
      </div>

      <h2>Zenith</h2>

      <p>
        A local-first productivity extension built to
        make focusing easier and mindless scrolling harder.
        Zenith brings together goal tracking, scheduled
        habits, website blocking, distraction analytics
        and a Pomodoro timer in a minimal new-tab experience.
      </p>

      <div class="tags">
        <span>React</span>
        <span>TypeScript</span>
        <span>Tailwind CSS</span>
        <span>Chrome Extension MV3</span>
      </div>
    </div>

    <p class="muted after-project">
      More projects as I keep building.
    </p>
  </div>
</Base>
