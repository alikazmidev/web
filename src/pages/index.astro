---
import Base from '../layouts/Base.astro';
---
<Base title="Ali Abbas Kazmi (Ali Kazmi) | Computer Science Student" description="Meet Ali Abbas Kazmi, also known as Ali Kazmi. A Computer Science student at University of the People, learning backend engineering and building for the web.">
 <div class="home-stage"><div class="page-grid" aria-hidden="true"><canvas id="interactive-dots"></canvas></div>
 <div class="wrap home">
  <section class="hero"><div class="hero-main"><div class="eyebrow">~/ali <span class="subtle-dot">•</span> a little corner of the internet</div><h1>Ali Abbas<br/><span>Kazmi<span class="period">.</span></span></h1><p class="hero-lead">Curious about how things work.</p><p class="hero-copy">I'm a Computer Science student and lifelong learner, currently exploring backend engineering and building things along the way.</p><div class="hero-actions"><a class="button-primary" href="/about/">More about me <span>↗</span></a><a class="text-link" href="/projects/">View projects <span>↗</span></a></div></div><aside class="hero-aside"><span class="section-label">A LITTLE ABOUT ME</span><p>Studying BS Computer Science at <strong>UoPeople</strong><br/><span>Expected graduation · Q4 2027</span></p><p>Self-studying <strong>backend engineering</strong><br/><span>One concept at a time</span></p><div class="aside-rule"></div><p class="aside-note">Outside the screen: solo walks, Radiohead, Red Dead Redemption 2 and finding something good to eat.</p></aside></section>
  <section class="feature-section"><div class="section-heading"><span class="section-label">01 / PROJECT</span><a class="small-link" href="/projects/">Projects ↗</a></div><a class="feature-row" href="/projects/"><div><h2>This website <span class="arrow">↗</span></h2><p>A personal space for learning, building and experimenting. Built with Astro and TypeScript.</p></div><span class="feature-meta">Astro / TypeScript</span></a></section>
  <div class="closing"><span class="mono">Still learning. Always curious.</span><span>Made with intention, not noise.</span></div>
 </div>
 </div>
</Base>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('#interactive-dots');
  const stage = document.querySelector<HTMLElement>('.home-stage');
  if (canvas && stage) {
    const context = canvas.getContext('2d');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    if (context) {
      const ctx = context;
      const pointer = { x: -1000, y: -1000, active: false };
      let width = 0;
      let height = 0;
      let frame = 0;
      let currentX = -1000;
      let currentY = -1000;
      let currentStrength = 0;
      const step = 23;
      const radius = 180;
      const motionAllowed = () => !reducedMotion.matches && finePointer.matches;
      const ink = () => getComputedStyle(document.documentElement).getPropertyValue('--grid-ink').trim() || 'rgba(55,77,63,.11)';
      function draw() {
        ctx.clearRect(0, 0, width, height);
        const dark = document.documentElement.dataset.theme === 'dark' || (!document.documentElement.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
        const color = dark ? '172,197,177' : '79,103,85';
        const centerX = width * .5;
        const centerY = Math.min(height * .34, 340);
        for (let y = step / 2; y < height; y += step) {
          for (let x = step / 2; x < width; x += step) {
            const nx = (x - centerX) / Math.max(width * .57, 1);
            const ny = (y - centerY) / Math.max(height * .6, 1);
            const fade = Math.max(0, 1 - nx * nx - ny * ny);
            if (fade < .02) continue;
            const dx = x - currentX;
            const dy = y - currentY;
            const distance = Math.hypot(dx, dy);
            const influence = Math.exp(-(distance * distance) / (radius * radius * .5)) * currentStrength;
            const shift = influence * 10;
            const movedX = x + (distance > 0 ? dx / distance * shift : 0);
            const movedY = y + (distance > 0 ? dy / distance * shift : 0);
            ctx.beginPath();
            ctx.fillStyle = `rgba(${color},${(dark ? .22 : .2) * fade + influence * .11})`;
            ctx.arc(movedX, movedY, .85 + influence * .4, 0, Math.PI * 2);
            ctx.fill();
          }
        }
        if (currentStrength > .005) {
          const glow = ctx.createRadialGradient(currentX, currentY, 0, currentX, currentY, radius * 1.3);
          glow.addColorStop(0, `rgba(104,145,113,${0.035 * currentStrength})`);
          glow.addColorStop(1, 'rgba(104,145,113,0)');
          ctx.fillStyle = glow;
          ctx.fillRect(0, 0, width, height);
        }
      }
      function tick() {
        frame = 0;
        const target = pointer.active && motionAllowed() ? 1 : 0;
        currentStrength += (target - currentStrength) * .13;
        if (pointer.active && motionAllowed()) {
          currentX += (pointer.x - currentX) * .19;
          currentY += (pointer.y - currentY) * .19;
        }
        draw();
        if (Math.abs(currentStrength - target) > .006 || (target > 0 && Math.hypot(pointer.x - currentX, pointer.y - currentY) > .7)) schedule();
      }
      function schedule() { if (!frame) frame = requestAnimationFrame(tick); }
      function resize() {
        const rect = stage.getBoundingClientRect();
        width = rect.width;
        height = rect.height;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        schedule();
      }
      stage.addEventListener('pointermove', event => {
        if (!motionAllowed()) return;
        const rect = stage.getBoundingClientRect();
        pointer.x = event.clientX - rect.left;
        pointer.y = event.clientY - rect.top;
        if (!pointer.active) { currentX = pointer.x; currentY = pointer.y; }
        pointer.active = true;
        schedule();
      }, { passive: true });
      stage.addEventListener('pointerleave', () => { pointer.active = false; schedule(); });
      window.addEventListener('blur', () => { pointer.active = false; schedule(); });
      reducedMotion.addEventListener('change', () => { pointer.active = false; schedule(); });
      finePointer.addEventListener('change', () => { pointer.active = false; schedule(); });
      new ResizeObserver(resize).observe(stage);
      new MutationObserver(schedule).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      resize();
    }
  }
</script>
