---
import Base from '../layouts/Base.astro';
import {getPosts,prettyDate} from '../lib/posts';
const posts=await getPosts();const post=posts[0];
---
<Base title="Ali Abbas Kazmi — Learning, building, exploring">
 <div class="wrap home">
  <section class="hero"><div class="hero-grid" aria-hidden="true"><canvas id="interactive-grid"></canvas></div><div class="hero-main"><div class="eyebrow">~/ali <span class="subtle-dot">•</span> a little corner of the internet</div><h1>Ali Abbas<br/><span>Kazmi<span class="period">.</span></span></h1><p class="hero-lead">Curious about how things work.</p><p class="hero-copy">I'm a Computer Science student and lifelong learner, currently exploring backend engineering and building things along the way.</p><div class="hero-actions"><a class="button-primary" href="/about/">More about me <span>↗</span></a><a class="text-link" href="/blog/">Read my writing <span>↗</span></a></div></div><aside class="hero-aside"><span class="section-label">A LITTLE ABOUT ME</span><p>Studying BS Computer Science at <strong>UoPeople</strong><br/><span>Expected graduation · Q4 2027</span></p><p>Self-studying <strong>backend engineering</strong><br/><span>One concept at a time</span></p><div class="aside-rule"></div><p class="aside-note">Outside the screen: solo walks, Radiohead, Red Dead Redemption 2 and finding something good to eat.</p></aside></section>
  <section class="feature-section"><div class="section-heading"><span class="section-label">01 / PROJECT</span><a class="small-link" href="/projects/">Projects ↗</a></div><a class="feature-row" href="/projects/"><div><h2>This website <span class="arrow">↗</span></h2><p>A personal space for learning, writing and experimenting. Built with Astro and a headless WordPress blog.</p></div><span class="feature-meta">Astro / WordPress</span></a></section>
  <section class="feature-section"><div class="section-heading"><span class="section-label">02 / WRITING</span><a class="small-link" href="/blog/">All writing ↗</a></div>{post ? <a class="feature-row" href={`/blog/${post.slug}/`}><div><h2>{post.title} <span class="arrow">↗</span></h2><p>{post.excerpt}</p></div><time class="feature-meta" datetime={post.date}>{prettyDate(post.date)}</time></a> : <p class="muted">Writing is coming soon.</p>}</section>
  <div class="closing"><span class="mono">Still learning. Always curious.</span><span>Made with intention, not noise.</span></div>
 </div>
</Base>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('#interactive-grid');
  const hero = document.querySelector<HTMLElement>('.hero');
  if (canvas && hero) {
    const context = canvas.getContext('2d');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    if (context) {
      const ctx = context;
      const pointer = { x: -1000, y: -1000, active: false };
      let width = 0;
      let height = 0;
      let frame = 0;
      let currentX = -1000;
      let currentY = -1000;
      let currentStrength = 0;
      const step = 48;
      const radius = 165;
      const motionAllowed = () => !reducedMotion.matches && finePointer.matches;
      const ink = () => getComputedStyle(document.documentElement).getPropertyValue('--grid-ink').trim() || 'rgba(55,77,63,.11)';
      const bend = (x: number, y: number) => {
        const dx = x - currentX;
        const dy = y - currentY;
        const distance = Math.hypot(dx, dy);
        const influence = Math.exp(-(distance * distance) / (radius * radius * .55)) * currentStrength;
        return { x: x + dx * influence * .085, y: y + dy * influence * .085, influence };
      };
      function draw() {
        ctx.clearRect(0, 0, width, height);
        const line = ink();
        ctx.lineWidth = 0.75;
        ctx.strokeStyle = line;
        const horizontal = (y: number) => {
          ctx.beginPath();
          for (let x = 0; x <= width + 8; x += 8) {
            const point = bend(x, y);
            if (x === 0) ctx.moveTo(point.x, point.y);
            else ctx.lineTo(point.x, point.y);
          }
          ctx.stroke();
        };
        const vertical = (x: number) => {
          ctx.beginPath();
          for (let y = 0; y <= height + 8; y += 8) {
            const point = bend(x, y);
            if (y === 0) ctx.moveTo(point.x, point.y);
            else ctx.lineTo(point.x, point.y);
          }
          ctx.stroke();
        };
        for (let x = step / 2; x < width; x += step) vertical(x);
        for (let y = step / 2; y < height; y += step) horizontal(y);
        if (currentStrength > .005) {
          const glow = ctx.createRadialGradient(currentX, currentY, 0, currentX, currentY, radius * 1.35);
          glow.addColorStop(0, `rgba(104,145,113,${0.095 * currentStrength})`);
          glow.addColorStop(.42, `rgba(104,145,113,${0.045 * currentStrength})`);
          glow.addColorStop(1, 'rgba(104,145,113,0)');
          ctx.fillStyle = glow;
          ctx.fillRect(0, 0, width, height);
        }
      }
      function tick() {
        frame = 0;
        const target = pointer.active && motionAllowed() ? 1 : 0;
        currentStrength += (target - currentStrength) * .13;
        if (pointer.active && motionAllowed()) {
          currentX += (pointer.x - currentX) * .19;
          currentY += (pointer.y - currentY) * .19;
        }
        draw();
        if (Math.abs(currentStrength - target) > .006 || (target > 0 && Math.hypot(pointer.x - currentX, pointer.y - currentY) > .7)) schedule();
      }
      function schedule() { if (!frame) frame = requestAnimationFrame(tick); }
      function resize() {
        const rect = hero.getBoundingClientRect();
        width = rect.width;
        height = rect.height;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        schedule();
      }
      hero.addEventListener('pointermove', event => {
        if (!motionAllowed()) return;
        const rect = hero.getBoundingClientRect();
        pointer.x = event.clientX - rect.left;
        pointer.y = event.clientY - rect.top;
        if (!pointer.active) { currentX = pointer.x; currentY = pointer.y; }
        pointer.active = true;
        schedule();
      }, { passive: true });
      hero.addEventListener('pointerleave', () => { pointer.active = false; schedule(); });
      window.addEventListener('blur', () => { pointer.active = false; schedule(); });
      reducedMotion.addEventListener('change', () => { pointer.active = false; schedule(); });
      finePointer.addEventListener('change', () => { pointer.active = false; schedule(); });
      new ResizeObserver(resize).observe(hero);
      new MutationObserver(schedule).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      resize();
    }
  }
</script>
